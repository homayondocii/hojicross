{
  "name": "CryptoPanic News Collector",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "step": 6
            }
          ]
        }
      },
      "id": "df1fd6a0-2c3a-4d89-a647-a22ef22467b1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://cryptopanic.com/api/v1/posts/?auth_token=bba51c5d0fdb67a9cd8bda5821b9beeae4e290d8&filter=important&kind=news",
        "method": "GET",
        "authentication": "none",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a8b4c6d0-1e2f-4g5h-6i7j-8k9l0m1n2o3p",
      "name": "CryptoPanic API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const results = items[0].json.results;\n\nreturn results.map(item => ({\n  json: {\n    title: item.title,\n    url: item.url,\n    source: `CryptoPanic - ${item.source.domain}`,\n    published_at: new Date(item.published_at).toISOString().slice(0, 19).replace('T', ' '),\n    summary: item.metadata ? item.metadata.description : item.title\n  }\n}));"
      },
      "id": "c7d8e9f0-3g4h-5i6j-7k8l-9m0n1o2p3q4r",
      "name": "Transform Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "crypto_news",
        "columns": "title,url,source,published_at,summary",
        "options": {
          "ignoreDuplicates": true
        },
        "credentials": {
          "host": "mariadb",
          "database": "news_db",
          "user": "news_user",
          "password": "StrongPassword123!"
        }
      },
      "id": "e5f6g7h0-4i5j-6k7l-8m9n-0o1p2q3r4s5t",
      "name": "Save to Database",
      "type": "n8n-nodes-base.mysql",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM crypto_news WHERE published_at < DATE_SUB(NOW(), INTERVAL 7 DAY);",
        "credentials": {
          "host": "mariadb",
          "database": "news_db",
          "user": "news_user",
          "password": "StrongPassword123!"
        }
      },
      "id": "i7j8k9l0-5m6n-7o8p-9q0r-1s2t3u4v5w6x",
      "name": "Cleanup Old News",
      "type": "n8n-nodes-base.mysql",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ]
    }
  ],
