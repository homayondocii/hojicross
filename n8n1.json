{
    "meta": {
        "instanceId": "YOUR_INSTANCE_ID"
    },
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "hours",
                            "step": 6
                        }
                    ]
                }
            },
            "id": "1",
            "name": "Schedule Trigger",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "url": "https://cryptopanic.com/api/v1/posts/?auth_token=bba51c5d0fdb67a9cd8bda5821b9beeae4e290d8&filter=important&kind=news",
                "method": "GET",
                "authentication": "none",
                "options": {}
            },
            "id": "2",
            "name": "CryptoPanic API",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3.1,
            "position": [
                450,
                300
            ]
        },
        {
            "parameters": {
                "mode": "runOnceForAllItems",
                "jsCode": "const item = $input.item;\nreturn {\n  title: item.json.title,\n  url: item.json.url,\n  source: 'CryptoPanic - ' + item.json.source.domain,\n  published_at: new Date(item.json.published_at).toISOString().slice(0, 19).replace('T', ' '),\n  summary: item.json.metadata ? item.json.metadata.description : item.json.title\n};"
            },
            "id": "3",
            "name": "Transform Data",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                650,
                300
            ]
        },
        {
            "parameters": {
                "operation": "insert",
                "table": "crypto_news",
                "columns": "title,url,source,published_at,summary",
                "options": {
                    "ignoreDuplicates": true
                }
            },
            "id": "4",
            "name": "Save to Database",
            "type": "n8n-nodes-base.mysql",
            "typeVersion": 1,
            "position": [
                850,
                300
            ],
            "credentials": {
                "mysql": {
                    "id": "1",
                    "name": "MySQL account"
                }
            }
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "DELETE FROM crypto_news WHERE published_at < DATE_SUB(NOW(), INTERVAL 7 DAY);"
            },
            "id": "5",
            "name": "Cleanup Old News",
            "type": "n8n-nodes-base.mysql",
            "typeVersion": 1,
            "position": [
                1050,
                300
            ],
            "credentials": {
                "mysql": {
                    "id": "1",
                    "name": "MySQL account"
                }
            }
        }
    ],
    "connections": {
        "Schedule Trigger": {
            "main": [
                [
                    {
                        "node": "CryptoPanic API",
                        "type": "main",
                        "index": 0
                    }
                ]
